# Copy this file to .env and fill in your own Twitch/IGDB app credentials.
# Get both at https://dev.twitch.tv/console — create an app, then use its
# Client ID and Client Secret below. The app uses these to automatically
# fetch and refresh IGDB access tokens — no manual token generation needed.
IGDB_CLIENT_ID=your_client_id_here
IGDB_CLIENT_SECRET=your_client_secret_here
