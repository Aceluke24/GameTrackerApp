{
  "name": "game-vault",
  "version": "1.2.2",
  "description": "Your personal game backlog tracker",
  "author": "Aceluke24 <aceluke24@gmail.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "electron": "electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "axios": "^1.6.7",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aceluke24.gamevault",
    "productName": "Game Vault",
    "directories": {
      "output": "release"
    },
    "protocols": {
      "name": "Game Vault",
      "schemes": [
        "gamevault"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Aceluke24",
      "repo": "GameTrackerApp"
    },
    "artifactName": "Game-Vault-${version}-${arch}.${ext}",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Game-Vault-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
